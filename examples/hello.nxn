// ===== NEXION FINAL BOSS =====

fun factorial(n) {
    if (n <= 1) {
        return 1;
    } else {
        return n * factorial(n - 1);
    }
}

fun process(data, limit) {
    let total = 0;
    let i = 0;

    while (i < limit) {
        if (i == 2) {
            i = i + 1;
            next;
        }

        if (data[i] > 10 and not (data[i] == 20)) {
            total = total + data[i];
        } else {
            total = total + 1;
        }

        i = i + 1;
    }

    return total;
}

let nums = [5, 15, 20, 25, 30];
let matrix = [[1, 2], [3, 4]];
let cube = [[[1, 2], [3, 4]], [[5, 6], [7, 8]]];

say("=== NEXION STRESS TEST ===");

say(nums[0]);
say(nums[4]);
say(matrix[0][1]);
say(matrix[1][0]);
say(cube[1][0][1]);

let x = 10;
let y = 5;

if (x > y and not (x == y)) {
    say("comparison works");

    {
        let inner = 100;
        x = x + inner;
        say(inner);
    }

    say(x);
} else {
    say("comparison failed");
}

while (y > 0) {
    if (y == 3) {
        y = y - 1;
        next;
    }

    say(y);
    y = y - 1;
}

let result = factorial(5);
say(result);

let processed = process(nums, 5);
say(processed);

say(factorial(nums[0]));

let nested = [[10, 20], [30, 40]];
say(nested[1][1]);


let flag = true;
let other = false;
let nothing = none;

if (flag or other) {
    say("boolean logic works");
}

if (not other) {
    say("unary not works");
}

say(nothing);

let empty = [];
say(empty);

// function call using indexed arguments
say(process([11, 12, 13, 14, 15], 5));

// deep nesting + arithmetic
say(cube[1][1][0] + cube[0][0][1] * 2);

// reassignment
x = x + 50;
y = 999;
say(x);
say(y);

say("=== TEST COMPLETE ===");