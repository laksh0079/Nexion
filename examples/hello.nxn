say("=== TEST 1: Basic Block Scope ===");

let x = 10;

{
    let x = 20;
    say(x);

    {
        let x = 30;
        say(x);
    }

    say(x);
}

say(x);


say("=== TEST 2: Block Assignment To Parent ===");

let total = 100;

{
    total = 200;
    say(total);
}

say(total);


say("=== TEST 3: IF Scope ===");

let value = 10;

if (true) {
    let value = 999;
    say(value);
}

say(value);


say("=== TEST 4: ELSE Scope ===");

let status = "outside";

if (false) {
    let status = "if";
    say(status);
} else {
    let status = "else";
    say(status);
}

say(status);


say("=== TEST 5: Nested IF Scopes ===");

let n = 5;

if (true) {
    let n = 10;

    if (true) {
        let n = 20;
        say(n);
    }

    say(n);
}

say(n);


say("=== TEST 6: WHILE Scope ===");

let i = 0;

while (i < 3) {
    let temporary = i;
    say(temporary);
    i = i + 1;
}

say(i);


say("=== TEST 7: Function Scope ===");

let x = 50;

fun test() {
    let x = 100;
    say(x);

    {
        let x = 200;
        say(x);
    }

    say(x);
}

test();

say(x);


say("=== TEST 8: Function Modifying Caller Variable ===");

let counter = 10;

fun modify() {
    counter = 999;
}

modify();

say(counter);


say("=== TEST 9: Function + Nested Block ===");

let value = 1;

fun nested() {
    let value = 2;

    {
        let value = 3;
        say(value);
    }

    say(value);
}

nested();

say(value);


say("=== TEST 10: RETURN Scope Restoration ===");

let x = 100;

fun early() {
    let x = 200;

    if (true) {
        let x = 300;
        return x;
    }
}

say(early());
say(x);


say("=== TEST 11: Recursive Scope ===");

fun countdown(n) {
    if (n <= 0) {
        return 0;
    } else {
        let current = n;
        say(current);
        return countdown(n - 1);
    }
}

countdown(3);


say("=== TEST 12: NEXT + Scope ===");

let i = 0;

while (i < 4) {
    i = i + 1;

    {
        let temp = i;

        if (i == 2) {
            next;
        }

        say(temp);
    }
}

say(i);


say("=== TEST 13: EXIT + Scope ===");

let j = 0;

while (j < 10) {
    j = j + 1;

    {
        let temp = j;

        if (j == 3) {
            exit;
        }

        say(temp);
    }
}

say(j);


say("=== TEST 14: Same Name Everywhere ===");

let a = 1;

{
    let a = 2;

    {
        let a = 3;

        if (true) {
            let a = 4;

            {
                let a = 5;
                say(a);
            }

            say(a);
        }

        say(a);
    }

    say(a);
}

say(a);


say("=== TEST 15: FINAL OUTER VARIABLE ===");

let result = 500;

fun complicated() {
    let result = 600;

    {
        let result = 700;

        if (true) {
            let result = 800;
            say(result);
        }

        say(result);
    }

    say(result);
}

complicated();

say(result);