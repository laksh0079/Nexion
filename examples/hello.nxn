let x = 10;
let total = 0;

fun add(a, b) {
    return a + b;
}

fun factorial(n) {
    if (n <= 1) {
        return 1;
    } else {
        return n * factorial(n - 1);
    }
}

fun check(n) {
    if (n < 0) {
        return "negative";
    } else if (n == 0) {
        return "zero";
    } else if (n % 2 == 0) {
        return "even";
    } else {
        return "odd";
    }
}

fun loop(limit) {
    let i = 0;
    let sum = 0;

    while (i < limit) {
        i = i + 1;

        if (i == 2) {
            next;
        }

        sum = sum + i;
    }

    return sum;
}

say(-10);
say(10--10);
say(10 + -5);
say(-5 * 3);

say(add(-10, 20));
say(factorial(5));

say(check(-10));
say(check(0));
say(check(7));
say(check(12));

total = loop(5);
say(total);

{
    let x = 999;
    say(x);
}

say(x);

say(none);
say(factorial(0));